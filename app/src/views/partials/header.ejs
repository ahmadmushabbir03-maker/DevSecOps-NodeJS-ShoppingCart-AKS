<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkyPulse | Ahmad Mushabbir Weather Operations</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= weather ? (weather.isNight ? 'theme-night' : 'theme-' + weather.mainCondition.toLowerCase()) : 'theme-default' %>">
    <div class="background-animation"></div>

    <header>
        <nav class="navbar">
            <div class="logo">
                <i class="fa-solid fa-cloud-bolt brand-icon"></i>
                <span class="brand-name">SkyPulse</span>
                <span class="signature-tag">by Ahmad Mushabbir</span>
            </div>

            <div class="status-badge">
                <span class="dot"></span> Live Telemetry
            </div>
        </nav>
    </header>
