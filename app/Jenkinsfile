#!/bin/bash
set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR"

if [ ! -d ".git" ]; then
    echo "ERROR: Must be executed inside the root of your Git repository."
    exit 1
fi

echo "---> Updating app/Jenkinsfile with explicit SonarQube Scanner Tool path..."
mkdir -p app

cat << 'EOF' > app/Jenkinsfile
pipeline {
    agent any

    environment {
        ACR_REGISTRY = 'ahmadweatheracr24486.azurecr.io'
        IMAGE_NAME   = 'skypulse-weather-dashboard'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        AZURE_RG     = 'ahmad-weather-rg'
        AKS_CLUSTER  = 'ahmad-weather-aks'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('NodeJS Build & Test') {
            steps {
                dir('app') {
                    sh 'npm install'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('app') {
                    script {
                        def scannerHome = tool 'SonarQube Scanner'
                        withSonarQubeEnv('SonarQube') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=skypulse-weather-dashboard \
                                -Dsonar.sources=.
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Snyk Dependency Security Scan') {
            steps {
                dir('app') {
                    sh 'snyk test --all-projects || true'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh "docker build -t ${ACR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh "trivy image --severity HIGH,CRITICAL ${ACR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }

        stage('Push Image to ACR') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'acr-credentials', usernameVariable: 'ACR_USER', passwordVariable: 'ACR_PASS')]) {
                    sh "docker login ${ACR_REGISTRY} -u ${ACR_USER} -p ${ACR_PASS}"
                    sh "docker push ${ACR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Helm Upgrade to AKS') {
            steps {
                withCredentials([azureServicePrincipal('azure-sp-credentials')]) {
                    sh "az aks get-credentials --resource-group ${AZURE_RG} --name ${AKS_CLUSTER} --overwrite-existing"
                    sh "helm upgrade --install skypulse skypulse-chart/ --set image.tag=${IMAGE_TAG}"
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout ${ACR_REGISTRY} || true'
            cleanWs()
        }
    }
}
EOF

echo "---> Committing and pushing Jenkinsfile update to GitHub..."
git add app/Jenkinsfile
git commit -m "fix(jenkinsfile): locate sonar-scanner executable via tool declaration"
git push origin main

echo "Done! Re-run your Jenkins pipeline job."