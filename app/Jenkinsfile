pipeline {
    agent any

    environment {
        ACR_REGISTRY = 'ahmadweatheracr24486.azurecr.io'
        IMAGE_NAME   = 'skypulse-weather-dashboard'
        IMAGE_TAG    = "${BUILD_NUMBER}"

        AZURE_RG     = 'ahmad-weather-rg'
        AKS_CLUSTER  = 'ahmad-weather-aks'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('NodeJS Build & Test') {
            steps {
                dir('app') {
                    sh 'npm install'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('app') {
                    script {
                        def scannerHome = tool 'SonarScanner'

                        withSonarQubeEnv('SonarQube') {
                            sh """
                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectKey=skypulse-weather-dashboard \
                              -Dsonar.sources=.
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Snyk Dependency Security Scan') {
            steps {
                dir('app') {
                    sh 'snyk test --all-projects || true'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh """
                    docker build -t ${ACR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                trivy image --severity HIGH,CRITICAL \
                ${ACR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Image to ACR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'acr-credentials',
                        usernameVariable: 'ACR_USER',
                        passwordVariable: 'ACR_PASS'
                    )
                ]) {

                    sh '''
                    echo "$ACR_PASS" | docker login '"${ACR_REGISTRY}"' \
                        --username "$ACR_USER" \
                        --password-stdin

                    docker push '"${ACR_REGISTRY}"'/'"${IMAGE_NAME}"':'"${IMAGE_TAG}"'
                    '''
                }
            }
        }

        stage('Helm Upgrade to AKS') {
            steps {

                withCredentials([
                    string(credentialsId: 'azure-client-id', variable: 'AZURE_CLIENT_ID'),
                    string(credentialsId: 'azure-client-secret', variable: 'AZURE_CLIENT_SECRET'),
                    string(credentialsId: 'azure-tenant-id', variable: 'AZURE_TENANT_ID')
                ]) {

                    sh '''
                    az login \
                      --service-principal \
                      --username "$AZURE_CLIENT_ID" \
                      --password "$AZURE_CLIENT_SECRET" \
                      --tenant "$AZURE_TENANT_ID"

                    az aks get-credentials \
                      --resource-group '"${AZURE_RG}"' \
                      --name '"${AKS_CLUSTER}"' \
                      --overwrite-existing

                    helm upgrade --install skypulse ./skypulse-chart \
                      --set image.repository='"${ACR_REGISTRY}"'/'"${IMAGE_NAME}"' \
                      --set image.tag='"${IMAGE_TAG}"'
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout ${ACR_REGISTRY} || true'
            cleanWs()
        }
    }
}